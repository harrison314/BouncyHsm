@rendermode InteractiveWebAssembly
@using BouncyHsm.Client
@inject IBouncyHsmClient bouncyHsmClient
@inject NavigationManager Navigation
@inject ILogger<GenerateHssKeys> logger

@if (this.isInLoading)
{
    <LoadingIndicator />
}
else
{
    <EditForm EditContext="@editContext" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="alert alert-info">
            HSS private keys are stateful. The private key is always generated as sensitive, non-extractable and non-copyable.
            Large LMS heights (H20, H25) can take minutes to generate.
        </div>

        <div class="mb-1">
            <label for="i-levels" class="form-label">HSS levels</label>

            <InputSelect class="form-select" Value="this.model.Levels" ValueExpression="() => this.model.Levels" ValueChanged="(int levels) => this.OnLevelsChanged(levels)" id="i-levels">
                @for (int level = 1; level <= 8; level++)
                {
                    <option value="@level" @key="level">@level</option>
                }
            </InputSelect>

            <ValidationMessage For="() => this.model.Levels" />
        </div>

        @for (int i = 0; i < this.model.Levels; i++)
        {
            int index = i;
            <div class="row mb-1" @key="index">
                <div class="col-6">
                    <label for="@($"i-lms-{index}")" class="form-label">Level @(index + 1) LMS type</label>
                    <InputSelect class="form-select" id="@($"i-lms-{index}")" @bind-Value="this.model.LmsTypes[index]">
                        @foreach (string lmsType in this.lmsTypes)
                        {
                            <option value="@lmsType" @key="lmsType">@lmsType</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label for="@($"i-lmots-{index}")" class="form-label">Level @(index + 1) LM-OTS type</label>
                    <InputSelect class="form-select" id="@($"i-lmots-{index}")" @bind-Value="this.model.LmotsTypes[index]">
                        @foreach (string lmotsType in this.lmotsTypes)
                        {
                            <option value="@lmotsType" @key="lmotsType">@lmotsType</option>
                        }
                    </InputSelect>
                </div>
            </div>
        }
        <hr />

        <div class="row mb-1">
            <label for="i-ckaid" class="form-label">CKA ID</label>

            <div class="row">
                <div class="col-9">
                    <InputText id="i-ckaid" class="form-control" @bind-Value="this.model.CkaIdText" />
                </div>
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="this.model.CkaIdForm">
                        <option value="@BinaryForm.Utf8">UTF-8</option>
                        <option value="@BinaryForm.Hex">HEX</option>
                        <option value="@BinaryForm.Base64">Base64</option>
                    </InputSelect>
                </div>
            </div>
            <div class="form-text">Value for CKA_ID is optinal. If is empty then will be generated on server.</div>
        </div>


        <div class="mb-1">
            <label for="i-ckalabel" class="form-label">CKA LABEL</label>
            <InputText id="i-ckalabel" class="form-control" @bind-Value="this.model.CkaLabel" />
            <div class="form-text">Value for CKA_LABEL.</div>
            <ValidationMessage For="() => this.model.CkaLabel" />
        </div>


        <div class="mb-1 form-check">
            <InputCheckbox class="form-check-input" id="i-forsigning" @bind-Value="this.model.ForSigning" />
            <label class="form-check-label" for="i-forsigning">For signing and verification</label>
            <ValidationMessage For="() => this.model.ForSigning" />
        </div>

        <div class="justify-content-end pt-4">
            <button type="submit" class="btn btn-primary"><span class="icon-plus icon-1x"></span> Submit</button>
        </div>
    </EditForm>
}
@code {

    [Parameter, EditorRequired]
    public int SlotId
    {
        get;
        set;
    }

    [Parameter]
    public EventCallback<bool> OnLoadingChanged
    {
        get;
        set;
    }

    private EditContext? editContext;
    private HssGenModel model = new HssGenModel();
    private bool isInLoading = false;
    private List<string> lmsTypes = new List<string>();
    private List<string> lmotsTypes = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        this.editContext = new EditContext(this.model);

        SupportedKeysDto keys = await this.bouncyHsmClient.GetSupportedKeysAsync();
        this.lmsTypes = keys.HssKeys.Where(t => t.StartsWith("LMS_", StringComparison.Ordinal)).ToList();
        this.lmotsTypes = keys.HssKeys.Where(t => t.StartsWith("LMOTS_", StringComparison.Ordinal)).ToList();

        this.model.SetDefaults(this.lmsTypes.FirstOrDefault() ?? "LMS_SHA256_M32_H5",
            this.lmotsTypes.FirstOrDefault() ?? "LMOTS_SHA256_N32_W8");
    }

    private void OnLevelsChanged(int levels)
    {
        this.model.Levels = levels;
        this.model.ResizeTypes();
    }

    private async Task HandleSubmit()
    {
        this.isInLoading = true;
        await this.OnLoadingChanged.InvokeAsync(true);
        await Task.Yield();
        try
        {
            _ = await this.bouncyHsmClient.GenerateHssKeyPairAsync(this.SlotId, this.model.ToDto());
            this.Navigation.NavigateTo($"Slots/{this.SlotId}/Pkcs");
        }
        catch (Exception ex)
        {
            this.logger.LogError(ex, "Error during GenerateHssKeyPairAsync.");
        }
        finally
        {
            this.isInLoading = false;
            await this.OnLoadingChanged.InvokeAsync(false);
        }
    }

    #region Model

    internal class HssGenModel : BaseGenerateModel
    {
        private string defaultLms = "LMS_SHA256_M32_H5";
        private string defaultLmots = "LMOTS_SHA256_N32_W8";

        public int Levels
        {
            get;
            set;
        }

        public string[] LmsTypes
        {
            get;
            set;
        }

        public string[] LmotsTypes
        {
            get;
            set;
        }

        public HssGenModel()
        {
            this.Levels = 1;
            this.LmsTypes = new string[8];
            this.LmotsTypes = new string[8];
            this.SetDefaults(this.defaultLms, this.defaultLmots);

            this.Sensitive = true;
            this.Exportable = false;

            this.ForWrap = false;
            this.ForEncryption = false;
            this.ForSigning = true;
            this.ForDerivation = false;
            this.ForEncapsulation = false;
        }

        internal void SetDefaults(string lms, string lmots)
        {
            this.defaultLms = lms;
            this.defaultLmots = lmots;
            this.ResizeTypes();
        }

        internal void ResizeTypes()
        {
            for (int i = 0; i < this.LmsTypes.Length; i++)
            {
                this.LmsTypes[i] ??= this.defaultLms;
                this.LmotsTypes[i] ??= this.defaultLmots;
            }
        }

        internal GenerateHssKeyPairRequestDto ToDto()
        {
            return new GenerateHssKeyPairRequestDto()
            {
                Levels = this.Levels,
                LmsTypes = this.LmsTypes.Take(this.Levels).ToList(),
                LmotsTypes = this.LmotsTypes.Take(this.Levels).ToList(),
                KeyAttributes = this.ToGenerateKeyAttributesDto()
            };
        }
    }

    #endregion
}
