  <ItemGroup>
    <ProjectReference Include="../ExampleApi/ExampleApi.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../src/Src/BouncyHsm.Aspire.Hosting/BouncyHsm.Aspire.Hosting.csproj')">
    <ProjectReference Include="../../../src/Src/BouncyHsm.Aspire.Hosting/BouncyHsm.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../../src/Src/BouncyHsm.Aspire.Hosting/BouncyHsm.Aspire.Hosting.csproj')">
    <PackageReference Include="BouncyHsm.Aspire.Hosting" Version="2.4" />
  </ItemGroup>

